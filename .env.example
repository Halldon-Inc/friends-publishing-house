# Signs session cookies. Required in production: `openssl rand -hex 32`.
SESSION_SECRET=
# Public URL of the site (used in share links and OG tags).
NEXT_PUBLIC_SITE_URL=http://localhost:3190
# Set on Vercel to store published mangas and worlds in Vercel Blob. Unset = local ./.data folder.
BLOB_READ_WRITE_TOKEN=
# Optional private Robinhood Chain RPC (tried first).
ROBINHOOD_RPC_URL=
# Local development only: allow "Dev sign-in" as this address, and read its cast from DEV_CAST_WALLET.
DEV_LOGIN_ADDRESS=
DEV_CAST_WALLET=
